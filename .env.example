# ==============================================================================
# .env.example — Template for crypto-coin-pipeline environment variables
# Copy this file to `.env` and fill in your actual values.
# NEVER commit `.env` to version control!
# ==============================================================================

# ── CoinGecko API ──────────────────────────────────────────────────────────────
# Demo/Pro API key (optional for low rate free tier, required for stable runs)
COINGECKO_API_KEY=your-coingecko-api-key-here

# ── AWS / MinIO (S3-compatible object storage) ────────────────────────────────
S3_BUCKET_NAME=crypto-raw-lake
AWS_DEFAULT_REGION=ap-southeast-1

# Local MinIO default credentials (matches docker/minio/docker-compose.yml):
AWS_ACCESS_KEY_ID=adminuser
AWS_SECRET_ACCESS_KEY=supersecretpassword123

# When running against real AWS S3, set real AWS credentials and leave S3_ENDPOINT_URL blank:
# S3_ENDPOINT_URL=
# For local dev / MinIO:
S3_ENDPOINT_URL=http://localhost:9000

# ── Airflow — Docker Compose Config ───────────────────────────────────────────
# Absolute path to the project root on the host machine (forward slashes on Windows)
AIRFLOW_PROJ_DIR=./
# Linux UID (`id -u`). On Windows/WSL2, default 50000 is fine.
AIRFLOW_UID=50000
# Fernet key for encrypting Airflow Connections & Variables in DB.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=VrnXJ7tFyRmQFe1KHQZas05A9oWrgji5wXvFUNkB5NQ=
# JWT secret for Airflow 3.x internal communication
AIRFLOW__API_AUTH__JWT_SECRET=change-me-to-a-secure-jwt-secret

# ── DuckDB / MotherDuck ────────────────────────────────────────────────────────
DUCKDB_S3_ENDPOINT=localhost:9000
DUCKDB_PATH=warehouse/crypto.duckdb
DUCKDB_S3_REGION=ap-southeast-1
# MotherDuck Cloud token (optional, leave blank for local DuckDB file mode):
MOTHERDUCK_TOKEN=

# ── Email Alerting — SMTP (Gmail STARTTLS) ────────────────────────────────────
# Gmail setup:
#   1. Enable 2-Step Verification: https://myaccount.google.com/security
#   2. Create App Password: https://myaccount.google.com/apppasswords
#   3. Use the 16-char App Password (NOT your Gmail login password) as SMTP_PASSWORD
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_SENDER=your-email@gmail.com
# Comma-separated list of alert recipient email addresses
ALERT_RECEIVERS=admin@example.com
