# ------------------------------------------------------------------------------
# 1. Security, Secrets & Environment Variables (CRITICAL)
# ------------------------------------------------------------------------------
# Environment variable files (any level)
.env
.env.*
*.env
!.env.example
!.env.template
!.env.sample

# Streamlit secrets
.streamlit/secrets.toml

# Cryptographic keys, certificates, & credentials
*.pem
*.key
*.p12
*.pfx
*.pkcs12
*.cer
*.crt
credentials/
secrets/
service_account*.json
google-credentials*.json
*credential*.json
*secret*.json
id_rsa
id_ed25519
*.id_rsa
*.id_ed25519
auth_token*
*.token
token.json

# ------------------------------------------------------------------------------
# 2. Data Engineering Storage, Warehouses & Data Lake (DuckDB, Parquet, SQLite)
